{
  "name": "skills-manager",
  "version": "2.0.0-offline",
  "private": true,
  "license": "MIT",
  "description": "Offline local service and tray app for AI skills, subagents, and MCP settings across three built-in tools and custom agents.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.app.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "tray": "node dist-server/server/index.js --tray",
    "cli": "tsx server/cli.ts",
    "lint": "eslint .",
    "test": "vitest run server"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "chokidar": "^6.0.0",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "i18next": "^26.5.12",
    "lucide-react": "^1.65.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "systray2": "^2.1.4",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^26.0.0"
  }
}
