{
  "name": "skills-manager-node-tray-offline",
  "version": "2.0.0-offline",
  "private": true,
  "license": "MIT",
  "description": "Offline local service and tray app for AI skills, subagents, and MCP settings across three built-in tools and custom agents.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.app.json && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "tray": "node dist-server/server/index.js --tray",
    "cli": "tsx server/cli.ts",
    "lint": "eslint .",
    "test": "vitest run server"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "i18next": "^25.0.0",
    "lucide-react": "^1.16.0",
    "multer": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.1",
    "systray2": "^2.1.4",
    "tailwind-merge": "^3.0.2",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^7.0.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
