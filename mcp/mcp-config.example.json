{
  "mcpServers": {
    "filesystem-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~"
      ],
      "env": {},
      "description": "提供本機指定工作目錄的安全檔案讀寫與搜尋能力 (Stdio 本機程序)"
    },
    "sqlite-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "--db-path",
        "~/local.db"
      ],
      "env": {},
      "description": "提供本機 SQLite 資料庫結構查詢與離線資料分析能力"
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "glpat-your-gitlab-token-here",
        "GITLAB_API_URL": "https://gitlab.com/api/v4"
      },
      "description": "串接 GitLab / 自架 GitLab API，支援專案搜尋、Issue、Merge Request、分支與檔案操作"
    }
  }
}
